# English Mastery has NO runtime secrets in code or in the APK.
# API keys (Groq / Gemini) are entered inside the app: Profile → AI keys & usage.
#
# Optional – only for signing release APKs locally (Route B) or in CI (as GitHub secrets):
EM_KEYSTORE_PATH=/absolute/path/to/english-mastery-release.keystore
EM_KEYSTORE_PASSWORD=change-me
EM_KEY_ALIAS=em
EM_KEY_PASSWORD=change-me
